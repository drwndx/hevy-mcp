HEVY_API_KEY=replace-with-your-hevy-api-key

# Optional hardening knobs (defaults shown)
# HEVY_ENABLE_WRITES=1               # default off: only the 14 read-only tools are exposed
# HEVY_ALLOWED_TOOLS=get_workouts,get_user_info   # allowlist; omit for all permitted tools
# HEVY_MAX_WRITES_PER_MINUTE=10
# HEVY_MAX_READS_PER_MINUTE=120
# HEVY_MAX_CONCURRENCY=4
# HEVY_DEDUP_WINDOW_MS=60000
# HEVY_BREAKER_COOLDOWN_MS=30000
# HEVY_MAX_WRITES_PER_SESSION=50
# HEVY_TIMEOUT_MS=15000
# HEVY_AUDIT_LOG=off                 # or a custom path
